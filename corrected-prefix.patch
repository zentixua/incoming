+    /** Temporary bounded observation: no owner getters, admission, service or ledger opens. */
+    private static final class PressureProbe {
+        final GameTestHelper helper;
+        final AtomicInteger progress;
+        final AtomicInteger entered = new AtomicInteger(), exited = new AtomicInteger();
+        final java.util.concurrent.atomic.AtomicLong firstEnter = new java.util.concurrent.atomic.AtomicLong();
+        final java.util.concurrent.atomic.AtomicLong lastExit = new java.util.concurrent.atomic.AtomicLong();
+        final ArrayList<Future<?>> tasks = new ArrayList<>();
+        final ArrayList<String> rows = new ArrayList<>();
+        final long began = System.nanoTime();
+        int samples;
+        PressureProbe(GameTestHelper helper, AtomicInteger progress) { this.helper = helper; this.progress = progress; }
+        void enter() { entered.incrementAndGet(); firstEnter.compareAndSet(0, System.nanoTime()); }
+        void exit() { exited.incrementAndGet(); lastExit.set(System.nanoTime()); }
+        void sample(String phase, long resident, ThreadPoolExecutor pool) {
+            if (++samples > 32 && samples % 50 != 0) return;
+            long workspace = ((java.util.concurrent.atomic.AtomicLong) read(RuinWorkers.class, null, "WORKSPACE_BYTES")).get();
+            var row = new StringBuilder("phase=").append(phase).append(" gameTick=").append(helper.getLevel().getGameTime())
+                    .append(" serverTick=").append(helper.getLevel().getServer().getTickCount())
+                    .append(" nanos=").append(System.nanoTime() - began).append(" resident=").append(resident)
+                    .append(" workspace=").append(workspace).append(" nonworker=").append(resident < 0 ? -1 : resident - workspace)
+                    .append(" progress=").append(progress.get()).append(" entered=").append(entered.get()).append(" exited=").append(exited.get())
+                    .append(" pool=").append(pool.getPoolSize()).append(" largest=").append(pool.getLargestPoolSize())
+                    .append(" core=").append(pool.getCorePoolSize()).append(" busy=").append(pool.getActiveCount())
+                    .append(" queue=").append(pool.getQueue().size()).append(" inFlight=").append(RuinWorkers.inFlight())
+                    .append(" detached=").append(RuinInputs.detachedBytes()).append(" results=").append(RuinResults.bytes());
+            for (Future<?> f : tasks) row.append(" task=").append(RuinWorkers.started(f)).append('/').append(f.isDone())
+                    .append('/').append(f.isCancelled()).append('/').append(RuinWorkers.finished(f));
+            for (var level : helper.getLevel().getServer().getAllLevels()) {
+                if (!level.hasData(ua.zentix.incoming.registry.ModAttachments.NUCLEAR_WORLD)) continue;
+                var world = level.getData(ua.zentix.incoming.registry.ModAttachments.NUCLEAR_WORLD);
+                row.append(" world=").append(level.dimension().location()).append(" reservation=").append(world.materialReservation);
+                Object prep = read(world, "prep"); row.append(" prep=").append(fields(prep, "readBytes", "preps", "archiveHints"));
+                var contexts = (java.util.Map<?, ?>) read(world, "ruins"); row.append(" contexts=").append(contexts.size());
+                int shown = 0;
+                for (var entry : contexts.entrySet()) {
+                    if (++shown > 8) break;
+                    Object ctx = entry.getValue();
+                    row.append(" ctx[").append(entry.getKey()).append("]=").append(fields(ctx, "shotBytes", "heightBytes", "flashedBytes", "blastBytes", "appliedBytes", "shots", "applied", "planned", "stood"));
+                    row.append(" inputs=").append(fields(read(ctx, "inputs"), "workers", "retired", "detachedBytes", "detached"));
+                }
+                row.append(" matter=").append(fields(read(world, "matter"), "movingBytes", "strandedBytes", "supportBacking", "inventoryCapacity"));
+                row.append(" settle=").append(fields(read(world, "settle"), "entries", "retiring", "busy"));
+            }
+            rows.add(row.toString());
+        }
+        void dump() {
+            for (String row : rows) Incoming.LOG.info("CI6 {}", row);
+            Incoming.LOG.info("CI6 terminal entered={} exited={} firstEnterNs={} lastExitNs={} samples={}", entered.get(), exited.get(), firstEnter.get() == 0 ? -1 : firstEnter.get()-began, lastExit.get() == 0 ? -1 : lastExit.get()-began, samples);
+        }
+        static String fields(Object target, String... names) {
+            if (target == null) return "absent";
