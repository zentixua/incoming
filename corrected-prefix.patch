+                if (value instanceof java.util.Collection<?> c) value = c.size();
+                else if (value instanceof java.util.Map<?,?> m) value = m.size();
+                out.append(name).append(':').append(value).append(',');
+            }
+            return out.toString();
+        }
+        static Object read(Object target, String name) { return read(target.getClass(), target, name); }
+        static Object read(Class<?> type, Object target, String name) {
