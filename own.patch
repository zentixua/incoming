diff --git a/.claude/rules/gametest.md b/.claude/rules/gametest.md
index 4e17f1ff1..7f593ea27 100644
--- a/.claude/rules/gametest.md
+++ b/.claude/rules/gametest.md
@@ -151,3 +151,9 @@ paths:
   Direct map insertion leaves `used=0`: a later shard batch crosses the 100-tick sweep after the 600-tick
   idle horizon, detaches the context, then resubmits through stale input ownership. `nuke_source_progress`
   starts after that horizon and crosses a real sweep while preserving fixed external memory pressure.
+
+- A standalone `ScarQueue` fixture that ends with a pending consumer must also retire its synthetic
+  world context with `forgetRuinsForTest`. Queue clear releases jobs/tickets, not that context's assembling
+  window. `nuke_look_ahead` verifies that an independent background consumer can start after cleanup.
+- Craft hull-order checks place the charge above the platform and test initial shielding from that same
+  source. A charge inside the platform can remain shielded after the entire selected hull disappears.
diff --git a/mod/src/devtest/java/ua/zentix/incoming/gametest/RuinBackgroundGameTests.java b/mod/src/devtest/java/ua/zentix/incoming/gametest/RuinBackgroundGameTests.java
index caccafd0e..45f88d51d 100644
--- a/mod/src/devtest/java/ua/zentix/incoming/gametest/RuinBackgroundGameTests.java
+++ b/mod/src/devtest/java/ua/zentix/incoming/gametest/RuinBackgroundGameTests.java
@@ -1342,7 +1342,13 @@ public final class RuinBackgroundGameTests {
         } finally {
             ScarQueue.seenForTest(null);
             q.clear(level);
+            // This standalone queue leaves an unseen consumer pending. It owns the synthetic
+            // detonation lifetime too; clearing only the queue cannot retire its assembling window.
+            NuclearWorld.get(level).forgetRuinsForTest(d.id());
         }
+        h.assertTrue(RuinWorkers.awaitForTest(RuinWorkers.Priority.NEAR, 60_000), "retired fixture workers did not exit");
+        h.assertTrue(RuinPlanner.planFresh(level, d, unseen, true).changedBlocks() > 0,
+                "retired fixture blocked an independent background consumer");
         h.succeed();
     }
 
