diff --git a/mod/src/devtest/java/ua/zentix/incoming/nuclear/world/NormalCarrierPreparationGameTests.java b/mod/src/devtest/java/ua/zentix/incoming/nuclear/world/NormalCarrierPreparationGameTests.java
