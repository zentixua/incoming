@@ -0,0 +1,103 @@
+package ua.zentix.incoming.nuclear.world;
+
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+import net.minecraft.world.phys.Vec3;
+import org.junit.jupiter.api.Test;
+import ua.zentix.incoming.nuclear.Detonation;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class RuinLayoutOwnershipTest {
+    private static Detonation geometry(double yield) {
+        return new Detonation(-1, new Vec3(3104.5, 63, 560.5), 63, yield,
+                true, 0, 0, 0, 20000, 0, 1, false, .25f);
+    }
+
+    @Test
+    void queuedCancellationReleasesWithoutConstructing() {
+        var bytes = new AtomicLong();
+        var calls = new AtomicInteger();
+        var d = geometry(1000);
+        var task = new NuclearPrep.LayoutBuild(d, g -> {
+            calls.incrementAndGet();
+            return NuclearPrep.layout(g);
+        }, bytes::addAndGet, NuclearPrep.layoutReservation(d));
+        assertTrue(bytes.get() > 0);
+        task.cancel(false);
+        task.run();
+        task.cancel(false);
+        assertEquals(0, calls.get());
+        assertEquals(0, bytes.get());
+    }
+
+    @Test
+    void cancelledActualBuilderKeepsWorkspaceUntilExecutionReturns() throws Exception {
+        var bytes = new AtomicLong();
+        var built = new CountDownLatch(1);
+        var release = new CountDownLatch(1);
+        var d = geometry(1000);
+        long reservation = NuclearPrep.layoutReservation(d);
+        var task = new NuclearPrep.LayoutBuild(d, g -> {
+            var result = NuclearPrep.layout(g);
+            built.countDown();
+            try { assertTrue(release.await(10, TimeUnit.SECONDS)); }
+            catch (InterruptedException e) { throw new AssertionError(e); }
+            return result;
+        }, bytes::addAndGet, reservation);
+        Thread worker = Thread.ofPlatform().unstarted(task);
+        try {
+            worker.start();
+            assertTrue(built.await(10, TimeUnit.SECONDS));
+            task.cancel(false);
+            assertTrue(task.isDone());
+            assertEquals(reservation, bytes.get(), "Future completion is not actual builder exit");
+            task.cancel(false);
+            assertEquals(reservation, bytes.get());
+        } finally {
+            release.countDown();
+            worker.join(10_000);
+        }
+        assertFalse(worker.isAlive());
+        assertEquals(0, bytes.get());
+        assertThrows(java.util.concurrent.CancellationException.class, () -> task.getNow(null));
+    }
+
+    @Test
+    void completedResultRetainsBackingUntilTransferOrDiscard() {
+        for (boolean transfer : new boolean[] {false, true}) {
+            var bytes = new AtomicLong();
+            var d = geometry(100);
+            var task = new NuclearPrep.LayoutBuild(d, NuclearPrep::layout, bytes::addAndGet,
+                    NuclearPrep.layoutReservation(d));
+            task.run();
+            var layout = task.getNow(null);
+            assertNotNull(layout);
+            assertEquals(layout.bytes(), bytes.get());
+            assertTrue(bytes.get() > 8L * (layout.order().length + layout.edge().length + layout.toScan().size()),
+                    "reverse index, tile objects and backing slack were omitted");
+            if (transfer) {
+                task.transferred();
+                assertNull(task.getNow(null), "transferred future retained the result");
+            } else task.cancel(false);
+            assertEquals(0, bytes.get());
+        }
+    }
+
+    @Test
+    void supportedHighYieldsFitOneWorkspaceAndRetainEntireZone() {
+        for (double yield : new double[] {100, 1000}) {
+            var d = geometry(yield);
+            var layout = NuclearPrep.layout(d);
+            long reservation = NuclearPrep.layoutReservation(d);
+            assertTrue(reservation > layout.bytes());
+            assertTrue(reservation + RuinWorkers.threadBufferBytes(384) * RuinWorkers.memoryThreads(256, 384)
+                    + RuinMemory.TRANSITION_ROOM < NuclearPrep.PLANS_CAP - (32L << 20),
+                    "honest layout reservation permanently closed 1-Mt admission");
+            assertEquals(yield == 100 ? 58486 : 268082, layout.order().length);
+            assertEquals(yield == 100 ? 63086 : 277736, layout.toScan().size());
+        }
+    }
+}
diff --git a/mod/src/test/java/ua/zentix/incoming/nuclear/world/RuinRecordsTest.java b/mod/src/test/java/ua/zentix/incoming/nuclear/world/RuinRecordsTest.java
new file mode 100644
index 000000000..b7a6b5dbb
--- /dev/null
+++ b/mod/src/test/java/ua/zentix/incoming/nuclear/world/RuinRecordsTest.java
@@ -0,0 +1,63 @@
+package ua.zentix.incoming.nuclear.world;
+
+import org.junit.jupiter.api.Test;
+import java.nio.ByteBuffer;
+import java.util.ArrayDeque;
+import java.util.List;
+import java.util.Random;
+import static org.junit.jupiter.api.Assertions.*;
+
+class RuinRecordsTest {
+    private static RuinRecords<Long> queue() { return new RuinRecords<>(8, ByteBuffer::putLong, ByteBuffer::getLong); }
+
+    @Test void snapshotsStayImmutableAcrossAppendDrainAndRestore() {
+        var queue = queue();
+        var expected = new ArrayDeque<Long>();
+        Random random = new Random(81);
+        for (int i = 0; i < 9000; i++) { long n = random.nextLong(); queue.addLast(n); expected.addLast(n); }
+        for (int i = 0; i < 319; i++) assertEquals(expected.removeFirst(), queue.removeFirst());
+        List<byte[]> snapshot = queue.snapshot();
+        var saved = new ArrayDeque<>(expected);
+        for (int i = 0; i < 20000; i++) {
+            if (!expected.isEmpty() && random.nextBoolean()) assertEquals(expected.removeFirst(), queue.removeFirst());
+            else { long n = random.nextLong(); expected.addLast(n); queue.addLast(n); }
+        }
+        var restored = queue();
+        snapshot.forEach(restored::restore);
+        restored.addLast(99L); saved.addLast(99L);
+        while (!saved.isEmpty()) assertEquals(saved.removeFirst(), restored.removeFirst());
+        assertTrue(restored.isEmpty());
+        assertEquals(expected.size(), queue.size());
+        for (long n : queue) assertEquals(expected.removeFirst(), n);
+    }
+
+    @Test void fullPagesAreSharedAndOnlyPartialEndsCopied() {
+        var queue = queue();
+        for (long i = 0; i < 10001; i++) queue.addLast(i);
+        var first = queue.snapshot();
+        queue.removeFirst(); queue.addLast(10001L);
+        var second = queue.snapshot();
+        for (int i = 1; i < first.size() - 1; i++) assertSame(first.get(i), second.get(i));
+        assertNotSame(first.getFirst(), second.getFirst());
+        assertNotSame(first.getLast(), second.getLast());
+        assertThrows(IllegalArgumentException.class, () -> queue.restore(new byte[7]));
+    }
+    @org.junit.jupiter.api.Test
+    void appendReservationCoversTailGrowthAndWholeBoundaryPages() {
+        var records = new RuinRecords<Long>(8, java.nio.ByteBuffer::putLong, java.nio.ByteBuffer::getLong);
+        for (long i = 0; i < 2L * RuinRecords.ROWS + 1; i++) {
+            long before = records.bytes(), reservation = records.growthBytes(1);
+            records.addLast(i);
+            org.junit.jupiter.api.Assertions.assertTrue(records.bytes() <= before + reservation,
+                    "A queue boundary allocated outside its admitted growth");
+        }
+        records.clear();
+        long backing = records.bytes();
+        records.restore(java.nio.ByteBuffer.allocate(8).putLong(7).array());
+        long before = records.bytes(), reservation = records.growthBytes(1);
+        records.addLast(8L);
+        org.junit.jupiter.api.Assertions.assertTrue(records.bytes() <= before + reservation,
+                "Restored partial tail copy exceeded its reservation");
+        org.junit.jupiter.api.Assertions.assertTrue(backing >= 128, "Retained deque backing was forgotten");
+    }
+}
diff --git a/mod/src/test/java/ua/zentix/incoming/nuclear/world/RuinWorkerMemoryTest.java b/mod/src/test/java/ua/zentix/incoming/nuclear/world/RuinWorkerMemoryTest.java
new file mode 100644
index 000000000..1590721a0
--- /dev/null
+++ b/mod/src/test/java/ua/zentix/incoming/nuclear/world/RuinWorkerMemoryTest.java
@@ -0,0 +1,110 @@
+package ua.zentix.incoming.nuclear.world;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class RuinWorkerMemoryTest {
+    private static final int HEIGHT = 384;
+    private static final long WINDOW_CAP = NuclearPrep.PLANS_CAP - (32L << 20);
+
+    @Test
+    void highConfiguredAndAutomaticUpperBoundsLeavePreparationRoomBeforePoolInitialization() {
+        // Automatic selection on a 48-logical-core dedicated server, and the maximum valid manual setting.
+        for (int desired : new int[]{48 - RuinWorkers.reserve(false), 256}) {
+            assertEquals(17, RuinWorkers.memoryThreads(desired, HEIGHT));
+            long bytes = RuinWorkers.bufferBytes(null, desired, HEIGHT);
+            assertEquals(17L * 48 * 48 * HEIGHT * 15, bytes);
+            assertTrue(bytes <= RuinWorkers.BUFFER_CAP);
+            assertTrue(bytes + RuinMemory.TRANSITION_ROOM + (32L << 20) < WINDOW_CAP,
+                    "The same reservation must leave input/result room before the first disk parser starts");
+        }
+        assertEquals(1, RuinWorkers.memoryThreads(1, HEIGHT));
+        assertEquals(4, RuinWorkers.memoryThreads(4, HEIGHT));
+    }
+
+    @Test
+    void actualHighCountPoolAndItsIdleExpiryKeepFutureAdmissionWithinWindow() throws Exception {
+        int desired = 256;
+        int admitted = RuinWorkers.memoryThreads(desired, HEIGHT);
+        ThreadPoolExecutor executor = RuinWorkers.newPool(admitted);
+        CountDownLatch started = new CountDownLatch(admitted);
+        CountDownLatch release = new CountDownLatch(1);
+        try {
+            for (int i = 0; i < admitted; i++) executor.execute(() -> {
+                started.countDown();
+                try { release.await(); } catch (InterruptedException e) { Thread.currentThread().interrupt(); }
+            });
+            assertTrue(started.await(5, TimeUnit.SECONDS));
+            assertEquals(admitted, executor.getPoolSize());
+            assertEquals(admitted, executor.getMaximumPoolSize());
+            long reserved = RuinWorkers.bufferBytes(executor, desired, HEIGHT);
+            assertEquals(reserved, RuinWorkers.residentBufferBytes(executor, HEIGHT));
+            assertTrue(reserved + RuinMemory.TRANSITION_ROOM < WINDOW_CAP);
+            // Use the production timeout policy with a shorter duration; no synthetic live-thread counter.
+            executor.setKeepAliveTime(1, TimeUnit.MILLISECONDS);
+            release.countDown();
+            awaitIdleExpiry(executor);
+            assertEquals(0, RuinWorkers.residentBufferBytes(executor, HEIGHT));
+            assertEquals(reserved, RuinWorkers.bufferBytes(executor, desired, HEIGHT));
+            assertTrue(reserved + RuinMemory.TRANSITION_ROOM < WINDOW_CAP);
+            // An expired pool can actually restart, still at its admitted parallelism.
+            executor.execute(() -> {});
+            assertTrue(executor.getPoolSize() <= admitted);
+        } finally {
+            release.countDown();
+            executor.shutdownNow();
+            assertTrue(executor.awaitTermination(5, TimeUnit.SECONDS));
+        }
+    }
+
+    @Test
+    void downsizeKeepsRunningThreadBuffersChargedUntilActualExit() throws Exception {
+        int admitted = RuinWorkers.memoryThreads(256, HEIGHT);
+        ThreadPoolExecutor executor = RuinWorkers.newPool(admitted);
+        CountDownLatch started = new CountDownLatch(admitted);
+        CountDownLatch release = new CountDownLatch(1);
+        try {
+            for (int i = 0; i < admitted; i++) executor.execute(() -> {
+                started.countDown();
+                try { release.await(); } catch (InterruptedException e) { Thread.currentThread().interrupt(); }
+            });
+            assertTrue(started.await(5, TimeUnit.SECONDS));
+            RuinWorkers.resize(executor, 2);
+            long oldBuffers = admitted * RuinWorkers.threadBufferBytes(HEIGHT);
+            assertEquals(oldBuffers, RuinWorkers.bufferBytes(executor, 2, HEIGHT));
+            assertEquals(oldBuffers, RuinWorkers.residentBufferBytes(executor, HEIGHT));
+            executor.setKeepAliveTime(1, TimeUnit.MILLISECONDS);
+            release.countDown();
+            awaitIdleExpiry(executor);
+            assertEquals(2 * RuinWorkers.threadBufferBytes(HEIGHT), RuinWorkers.bufferBytes(executor, 2, HEIGHT));
+        } finally {
+            release.countDown();
+            executor.shutdownNow();
+            assertTrue(executor.awaitTermination(5, TimeUnit.SECONDS));
+        }
+    }
+
+    @Test
+    void tallerWorldsReduceActualParallelismWithoutReducingThePerCellCharge() {
+        for (int height : new int[]{256, 384, 1024, 4064}) {
+            int count = RuinWorkers.memoryThreads(256, height);
+            long bytes = RuinWorkers.bufferBytes(null, 256, height);
+            assertEquals((long) count * 48 * 48 * height * 15, bytes);
+            assertTrue(bytes <= RuinWorkers.BUFFER_CAP);
+            assertTrue(bytes + RuinMemory.TRANSITION_ROOM < WINDOW_CAP);
+        }
+        assertEquals(6, RuinWorkers.memoryThreads(256, 1024));
+    }
+
+    private static void awaitIdleExpiry(ThreadPoolExecutor executor) throws InterruptedException {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        while (executor.getPoolSize() != 0 && System.nanoTime() < deadline) Thread.sleep(1);
+        assertEquals(0, executor.getPoolSize(), "Idle threads must release their ThreadLocal buffers");
+    }
+}
