+                int i = wd << 6 | Long.numberOfTrailingZeros(bits);
+                bits &= bits - 1;
+                int wx = i % SIDE, wz = (i / SIDE) % SIDE, y = i / (SIDE * SIDE) + yb;
+                Blast.Props p = props(wx, y, wz);
+                if (p.leaves() || p.log()) seeds.add(i);
+            }
+        }
