+        while (!queue.isEmpty()) {
+            int i = (int) queue.dequeueLong();
+            if (bit(seen, i)) continue;
+            set(seen, i);
+            int wx = i % SIDE, wz = (i / SIDE) % SIDE, y = i / (SIDE * SIDE) + yb;
+            boolean held = false;
+            for (Direction dir : Direction.values()) {
+                int nx = wx + dir.getStepX(), ny = y + dir.getStepY(), nz = wz + dir.getStepZ();
